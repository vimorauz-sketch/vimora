# =====================================================================================
# VIMORA environment configuration — copy to .env and fill in. NEVER commit .env.
# Values marked REQUIRED IN PRODUCTION are validated at startup (the API refuses to start).
# Generate secrets with: ./infrastructure/scripts/gen-secrets.sh
# =====================================================================================

# --- Application ------------------------------------------------------------------
APP_ENV=production                        # development | test | production
VIMORA_DOMAIN=example.com                 # REQUIRED: your domain (DNS A record -> VPS IP)
ACME_EMAIL=admin@example.com              # REQUIRED: Let's Encrypt account email
APP_URL=https://example.com               # REQUIRED: public URL (https)
FRONTEND_URL=https://example.com
API_URL=https://example.com               # API is served under /api on the same origin
SECRET_KEY=                               # REQUIRED: >= 32 random chars
SETTINGS_ENCRYPTION_KEY=                  # REQUIRED: Fernet key (encrypts AI keys / MFA secrets in DB)
DEFAULT_LANGUAGE=uz
DEFAULT_CURRENCY=UZS
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
HEALTH_DETAILS_TOKEN=                     # optional: enables /api/v1/health/details with X-Health-Token (internal use)

# --- Database / cache -------------------------------------------------------------
POSTGRES_PASSWORD=                        # REQUIRED: strong random password
REDIS_PASSWORD=                           # REQUIRED: strong random password
# DATABASE_URL and REDIS_URL are composed in docker-compose.prod.yml from the passwords above.
# Set them explicitly only when running outside Docker:
# DATABASE_URL=postgresql+psycopg://vimora:PASSWORD@127.0.0.1:5432/vimora
# REDIS_URL=redis://:PASSWORD@127.0.0.1:6379/0

# --- Sessions ---------------------------------------------------------------------
SESSION_TTL_HOURS=336
ADMIN_SESSION_TTL_HOURS=12
# COOKIE_DOMAIN=                          # leave empty for host-only cookies (recommended)

# --- Email (SMTP) — CONFIGURATION REQUIRED for verification & password reset ----------
EMAIL_BACKEND=smtp                        # smtp | disabled  (console is development-only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# --- Telegram bot (optional) ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=                    # without @, used for customer linking deep links
TELEGRAM_ADMIN_ID=                        # your numeric Telegram user id (comma separated for several)
TELEGRAM_NOTIFICATION_CHAT_ID=            # optional: group/channel id for admin notifications
TELEGRAM_WEBHOOK_SECRET=                  # REQUIRED if bot token set: random 32+ chars
TELEGRAM_WEBHOOK_URL=                     # optional override; default https://DOMAIN/api/v1/webhooks/telegram/<secret>

# --- AI provider (optional fallback; prefer configuring in Admin -> AI control) ------------
AI_PROVIDER=                              # anthropic | openai | openai_compatible
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_DAILY_BUDGET=5.00
AI_MAX_TOKENS_PER_CALL=4096

# --- Isolated code sandbox (optional; a SEPARATE docker host, never this server's socket) -
SANDBOX_ENABLED=false
SANDBOX_DOCKER_HOST=                      # e.g. ssh://sandbox@10.0.0.5

# --- Payments ----------------------------------------------------------------------------
# Click (merchant API callbacks: https://DOMAIN/api/v1/webhooks/click/prepare and /complete)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Payme (merchant API endpoint: https://DOMAIN/api/v1/webhooks/payme, account field: payment_ref)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz   # use https://test.paycom.uz for the sandbox
# Stripe (webhook: https://DOMAIN/api/v1/webhooks/stripe — events checkout.session.*)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MANUAL_PAYMENTS_ENABLED=false

# --- File storage ------------------------------------------------------------------------
STORAGE_BACKEND=local                     # local | s3
S3_ENDPOINT=                              # empty for AWS; set for MinIO / other S3-compatible
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_MB=25
USER_STORAGE_QUOTA_MB=500
DOWNLOAD_LINK_TTL_SECONDS=300
CLAMAV_HOST=                              # optional malware scanning (clamd)
CLAMAV_PORT=3310

# --- Backups -----------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT=                     # optional: encrypt dumps to this GPG key (recommended)

# --- Observability -----------------------------------------------------------------------
SENTRY_DSN=                               # integration point; not wired by default
